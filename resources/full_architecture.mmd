    %% ══════════════════════════════════════════════════════════════════════
    %% DATA FLOWS
    %% ══════════════════════════════════════════════════════════════════════

    %% Client → Frontend
    BROWSER -->|"HTTPS"| CF
    CF -->|"serves static assets"| S3FE

    %% Client → REST API
    BROWSER -->|"REST HTTPS"| APIGW
    APIGW -->|"every protected route"| AUTHORIZER
    AUTHORIZER -->|"token lookup"| TBL_SES

    %% REST routes → Lambdas
    APIGW -->|"POST /auth/*"| AUTH_FN
    APIGW -->|"GET /patients[/{id}]"| PAT_FN
    APIGW -->|"POST /patients/{id}/upload"| UP_FN
    APIGW -->|"POST /patients/{id}/diagnose"| DX_FN
    APIGW -->|"POST /assistant/query\nGET /patients/{id}/chat"| AST_FN
    APIGW -->|"GET /patients/{id}/image-url"| INF_FN

    %% Client → WebSocket
    BROWSER -->|"WSS"| WSAPI
    WSAPI -->|"$connect / $disconnect"| CONN_FN
    CONN_FN --- TBL_CONN

    %% Auth handler
    AUTH_FN --- TBL_USR
    AUTH_FN --- TBL_SES
    AUTH_FN --- TBL_AUDIT
    AUTH_FN --- TBL_LOGIN
    AUTH_FN -->|"read HMAC salt"| SECRET

    %% Patient handler
    PAT_FN --- TBL_PAT
    PAT_FN --- TBL_DX
    PAT_FN --- TBL_AUDIT
    PAT_FN -->|"presigned GET"| S3DICOM

    %% Upload handler
    UP_FN -->|"issue presigned PUT URL"| S3DICOM
    UP_FN --- TBL_PAT
    UP_FN --- TBL_AUDIT

    %% S3 event → SQS
    S3DICOM -->|"S3 ObjectCreated\nprefix: uploads/"| SQS
    KMS -.->|"encrypts"| SQS
    SQS -.->|"after 3 failures"| DLQ

    %% Diagnostic handler → SQS
    DX_FN -->|"SendMessage"| SQS
    DX_FN --- TBL_PAT
    DX_FN --- TBL_DX
    DX_FN --- TBL_AUDIT

    %% Inference worker pipeline
    SQS -->|"SQS event source"| INF_FN
    INF_FN -->|"download DICOM"| S3DICOM
    INF_FN -->|"read pre-computed\nVLM results  demo mode"| S3DICOM
    INF_FN --- TBL_PAT
    INF_FN --- TBL_DX
    INF_FN --- TBL_AUDIT
    INF_FN -->|"push result via WS mgmt API"| WSAPI

    %% SageMaker OFFLINE bypass
    INF_FN -. "⚠️ bypassed in demo\nwould call InvokeEndpoint\nif SM endpoint were online" .-> SM_EP
    SM_MODEL -.-> SM_EC -.-> SM_EP

    %% Assistant handler
    AST_FN -->|"kNN vector search"| OS
    AST_FN -->|"LLM completion\n(SM endpoint empty → Bedrock)"| CLAUDE
    OS -.->|"embed query"| TITAN
    AST_FN --- TBL_PAT
    AST_FN --- TBL_DX
    AST_FN --- TBL_CHAT
    AST_FN --- TBL_AUDIT

    %% Demo layer → AWS resources  (dashed green)
    SD -. "seed DICOMs\n+ reference_outputs/" .-> S3DICOM
    SP -. "seed patients" .-> TBL_PAT
    SDB -. "seed users\n& initial data" .-> TBL_USR
    SOS -. "ingest RAG\ndocuments" .-> OS